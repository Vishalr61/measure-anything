<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- This app does NOT track users and does NOT collect data that is linked
	     to users' identities. The only required-reason API accessed is
	     NSUserDefaults, used exclusively to persist user preferences (last
	     selected category, unit pair, session state, and onboarding flag).       -->

	<key>NSPrivacyTracking</key>
	<false/>

	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<key>NSPrivacyCollectedDataTypes</key>
	<array/>

	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!-- UserDefaults: used to persist session state (category, unit pair,
			     input value), onboarding completion flag, and dice roll history.
			     Reason CA92.1 — accessed to store and read user preferences on the
			     same device, not shared across apps or uploaded to a server.       -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
